{
  "name": "@ctrl-y/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/entry.ts",
    "build": "wrangler deploy --dry-run --config ../../wrangler.toml",
    "type-check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "dev:workers": "wrangler dev --config ../../wrangler.toml",
    "deploy": "wrangler deploy --config ../../wrangler.toml"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@ctrl-y/database": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "vitest": "4.1.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": "22"
  }
}
