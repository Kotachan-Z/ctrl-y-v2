JWT_SECRET=local-development-only-ctrl-y-change-before-deploy-2026

# Required: replace placeholders using npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Leave empty locally to print reset links instead of sending email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WEB_ORIGIN=http://127.0.0.1:5173
