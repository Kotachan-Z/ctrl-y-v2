{
  "name": "ctrl-y-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "tsc --noEmit && turbo type-check",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "dev:workers": "bun run --filter @ctrl-y/api dev:workers",
    "deploy": "bun run --filter @ctrl-y/api deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "packageManager": "bun@1.4.4"
}
