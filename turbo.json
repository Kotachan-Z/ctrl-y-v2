{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_PORT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
